// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	// More info on Microsoft Python 3 VS Code Dev Containers can be found at https://github.com/microsoft/vscode-dev-containers/blob/main/containers/python-3/README.md
	"image": "mcr.microsoft.com/devcontainers/python:3.15-trixie",
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "sh .devcontainer/setup.sh",
	// Define the timezone for your dev container's local time 🤓 - https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
	"containerEnv": {
		"TZ": "America/Los_Angeles"
	},
	// Put the project venv first on PATH so `python` and `pytest` use the pinned requirements, not the image's pipx tools.
	"remoteEnv": {
		"PATH": "${containerWorkspaceFolder}/apps/hello_world/.venv/bin:${containerEnv:PATH}"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/apps/hello_world/.venv/bin/python"
			}
		}
	}
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}